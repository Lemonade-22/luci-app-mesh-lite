#!/bin/sh /etc/rc.common
# mesh-lite-agent - optional read-only observer for luci-app-mesh-lite.
# Disabled by default on the AC itself; enable it on APs you want to observe.

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled

	config_load mesh-lite-agent
	config_get_bool enabled agent enabled 1

	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance mesh-lite-agent
	procd_set_param command /usr/bin/mesh-lite-agent
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
