config settings 'general'
	option role 'standalone'
	option md_auto '1'
	option mobility_domain ''
	option enable_r '1'
	option enable_k '1'
	option enable_v '1'
	option ft_over_ds '1'
	option ft_psk_generate_local '1'
	option restrict_key_source '0'
	option ssh_timeout '10'
	option poll_interval '30'
	option secrets_path '/etc/mesh-lite/secrets'
	# 收敛版本号：每次成功下发 +1，随 payload 写到 AP 的 /etc/mesh-lite.ver，巡检据此比对。
	option config_ver '0'
	# 1 = 校验收到的 AP 主机密钥（需先授权过，使密钥记录到 known_hosts）；0 = 沿用 ssh -y。
	option ssh_strict_hostkey '0'

config profile 'profile'
	option ssid ''
	option key ''
	option encryption 'psk2'
	option hidden '0'
	option channel_2g 'auto'
	option channel_5g 'auto'
	option txpower_2g ''
	option txpower_5g ''
	option beacon '100'
	option bw_2g 'HT20'
	option bw_5g 'VHT80'
	option enable_r_2g '0'
	option enable_r_5g '1'

config wizard 'wizard'
	option enable_r_5g ''
	option enable_r_2g ''
	option enable_k ''
	option enable_v ''
	option ft_over_ds ''
	option ft_psk_generate_local ''
	option beacon ''
